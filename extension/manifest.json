{
  "manifest_version": 3,
  "name": "cap context",
  "description": "Carry conversation context between Claude, ChatGPT, Gemini, Grok, and DeepSeek.",
  "version": "1.4.31",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://context-generator-five.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Carry context to another AI",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*", "https://grok.com/*", "https://chat.deepseek.com/*"],
      "js": ["json-capture-metrics-main.js", "network-json-data.js", "network-fetch-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://gemini.google.com/*", "https://grok.com/*", "https://chat.deepseek.com/*"],
      "js": ["transfer-diagnostics.js", "json-capture-metrics.js", "network-json-capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["json-capture-metrics-main.js", "chatgpt-fetch-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["transfer-diagnostics.js", "json-capture-metrics.js", "chatgpt-json-capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["json-capture-metrics-main.js", "claude-fetch-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["transfer-diagnostics.js", "json-capture-metrics.js", "claude-json-capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["transfer-diagnostics.js", "platform-content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://spreadz.in/analysis*",
        "https://spidey889.github.io/context-generator/analysis*"
      ],
      "js": ["analysis-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png", "bubble-icon.png", "logos/*.png", "fonts/*.woff2"],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ]
    }
  ]
}
