{
  "manifest_version": 3,
  "name": "Context Generator",
  "description": "Automatically transfer your conversation context from Claude to ChatGPT.",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*.claude.ai/*",
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Generate context and paste into ChatGPT",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.claude.ai/*"],
      "js": ["claude-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.chatgpt.com/*", "https://*.openai.com/*"],
      "js": ["chatgpt-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png"],
      "matches": ["https://*.claude.ai/*"]
    }
  ]
}
