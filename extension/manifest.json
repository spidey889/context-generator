{
  "manifest_version": 3,
  "name": "Context Generator",
  "description": "Carry conversation context between Claude, ChatGPT, Gemini, Grok, and DeepSeek.",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab", // required to start a handoff from the user-selected active AI tab.
    "scripting", // required to inject/reinject platform-content.js into supported AI tabs.
    "tabs" // required to open, warm, focus, and message destination AI tabs.
  ],
  "host_permissions": [
    "https://*.claude.ai/*", // required to show the button, scrape Claude chats, and paste summaries into Claude.
    "https://chatgpt.com/*", // required to show the button, scrape ChatGPT chats, and paste summaries into ChatGPT.
    "https://*.chatgpt.com/*", // required for ChatGPT subdomains that host the same chat experience.
    "https://openai.com/*", // required for OpenAI-hosted ChatGPT pages that use the OpenAI domain.
    "https://*.openai.com/*", // required for OpenAI subdomains that can host ChatGPT pages.
    "https://gemini.google.com/*", // required to show the button, scrape Gemini chats, and paste summaries into Gemini.
    "https://grok.com/*", // required to show the button, scrape Grok chats, and paste summaries into Grok.
    "https://chat.deepseek.com/*", // required to show the button, scrape DeepSeek chats, and paste summaries into DeepSeek.
    "https://context-generator-five.vercel.app/*" // required for background requests to the summarization backend.
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Carry context to another AI",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://openai.com/*",
        "https://*.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["platform-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png", "bubble-icon.png", "logos/*.png"],
      "matches": [
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://openai.com/*",
        "https://*.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{8f4d7c20-9f3b-4b7e-9c11-2f4cbe2d41a9}",
      "data_collection_permissions": { "required": ["personalCommunications"] }
    }
  }
}
